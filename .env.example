# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Server Port (fixed 3000 in AI Studio environment)
PORT=3000
NODE_ENV="development"

# MongoDB connection string. Leave EMPTY only for throwaway local testing -
# without it every registration, payment and ticket is lost when the server restarts.
# Local:  mongodb://127.0.0.1:27017/deception
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/deception?retryWrites=true&w=majority
MONGO_URI=""

# Cloudinary Configuration for ID Card uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email - preferred route: the Apps Script relay (scripts/email-sender.gs), deployed
# under sfit.aidg@gmail.com. Plain HTTPS, so it works on Render's free tier, which
# blocks outbound SMTP. When both are set the relay wins over SMTP below.
EMAIL_RELAY_URL=""
EMAIL_RELAY_TOKEN=""

# SMTP / Email Configuration (fallback for hosts that allow outbound SMTP)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="adg.deception@student.sfit.ac.in"

# Admin portal login. CHANGE THIS before deploying - it is the account that
# approves payments and can export every participant's personal details.
ADMIN_PASSWORD="Deception@2026"

# Set to "true" only if you want the demo/sample registrations loaded.
# Leave unset in production: the samples pollute the dashboard and exports.
SEED_DEMO_DATA="false"

# JWT Authentication
JWT_SECRET="deception_adg_jwt_secret_2026_super_secure_key"

# Payment Module Integration
# MOCK_PAYMENT=true forces the mock provider for EVERY request, ignoring the
# method the student picked. Must be "false" for real payments.
MOCK_PAYMENT="true"
PAYMENT_SERVICE_URL=""

# Razorpay (test keys work without KYC; swap for live keys at go-live)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set this to the secret you enter in the Razorpay dashboard webhook config.
# Webhooks are REJECTED with 401 when this is empty.
RAZORPAY_WEBHOOK_SECRET=""

# UPI VPA used for the Manual UPI QR fallback
# ---- Google Drive for ID card images ----
# Deploy scripts/drive-upload.gs as a Web App under the ADG Google account and paste
# its /exec URL here. The script writes to that account's own Drive, so this server
# never holds a Google credential - the token below is the only secret.
# Leave both blank and ID cards are kept in the database instead.
DRIVE_UPLOAD_URL=""
DRIVE_UPLOAD_TOKEN=""

# Can one person be in more than one squad?
# "false" suits a single live match - you cannot physically play two teams at once,
# and it stops one person being counted (and charged) twice by mistake.
# "true" suits an event with several slots, or while testing with one email.
ALLOW_MULTIPLE_TEAMS="true"

# ============ FEES ============
# The registration fee per PARTICIPANT. A 5-player squad owes 5x this, a 6-player
# squad owes 6x. This single value drives the expected total, the amount the
# organiser must see before a squad can be approved, and the fee shown on the
# home page, the rules and the FAQ. Change it here and restart - nothing else.
PER_HEAD_AMOUNT="50"
CURRENCY="INR"

UPI_PAYEE_NAME="ADG DECEPTION"
UPI_VPA="your-upi-id@bank"
